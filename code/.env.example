# --- Database ---
# Used by the running app (docker-compose service name "db")
DATABASE_URL=postgresql+psycopg2://scholarlink:scholarlink@localhost:5432/scholarlink

# --- Auth ---
# Generate a real secret for non-local environments, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-real-environments
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- File storage (used from Phase 2 onward) ---
UPLOAD_DIR=./uploads

# --- App ---
ENVIRONMENT=development
